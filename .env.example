# ============================================================
# i2i-yield-watch — Environment Variables
# ============================================================
# This file is the single source of truth for runtime
# config. The real values live in .env (encrypted via
# git-crypt and committed to the repo).
#
# To bootstrap a fresh checkout:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in your secrets.
#   3. If you've exported the git-crypt key, unlock it:
#        git-crypt unlock /path/to/git-crypt-key
#
# For GitHub Actions, see .github/workflows/scrape.yml.
# The .env file is decrypted from a base64 secret named
# GIT_CRYPT_KEY in CI.
# ============================================================

# --- SCRAPER SETTINGS ---
# --- RATE GATES (two distinct thresholds — do NOT conflate) ---
# NOTIFY gate: ALERT on loans with rate > this (free, read-only).
NOTIFY_MIN_RATE_PCT=40

# Priority LABEL thresholds (display bucket only — NOT the notify gate)
PRIORITY_HIGH_RATE_PCT=70
PRIORITY_MEDIUM_RATE_PCT=50

# AUTO-INVEST gate: place REAL MONEY only on rate > this (100 = >100% loans).
# AUTOINVEST_MIN_RATE_PCT=100

# --- MULTI-ACCOUNT PORTFOLIO (accounts.py) ---
# The platform caps ~Rs 5,000 per loan per investor, so the portfolio runs one
# account per i2i login. The DEFAULT account keeps the legacy unprefixed names
# (I2I_EMAIL / I2I_PASSWORD / I2I_TXN_PIN / I2I_UPI_ID / AUTOINVEST_MIN_RATE_PCT);
# every secondary account uses I2I_<ACCOUNT>_* names. Select with --account or
# I2I_ACCOUNT; declare the whole portfolio with I2I_ACCOUNTS.
# I2I_ACCOUNTS=chirag,neeru
# I2I_ACCOUNT=chirag
#
# neeru (secondary account) example:
# I2I_NEERU_EMAIL=whyiswhen1@gmail.com
# I2I_NEERU_PASSWORD=...
# I2I_NEERU_TXN_PIN=1234
# I2I_NEERU_UPI_ID=...@ybl
# I2I_NEERU_CSRF_TOKEN=...   # fallback auth only (expires)
# I2I_NEERU_SESSION_ID=...   # fallback auth only (expires)
# I2I_NEERU_AUTOINVEST_MIN_RATE_PCT=150

# Random 0..N ms startup jitter to spread CI load.
STARTUP_JITTER_MS=2000

# --- NOTIFY CADENCE ---
# Default: notify when the QUALIFYING SET CHANGES (a loan appears
# or drops) — not only on brand-new loans, and never spamming an
# unchanged set every run.
# Optional periodic digest: re-send the current qualifying set at
# least once per N hours even when unchanged. 0/unset = change-only.
# I2I_DIGEST_HOURS=12
# I2I_DIGEST=true   # shortcut for a 24h digest

# --- FIREBASE (FIRESTORE) ---
# All persistent state lives in Cloud Firestore. The
# scraper authenticates with a service account; the
# dashboard reads publicly via the JS SDK + RLS.
#
# Local dev: drop the service account JSON at the project
# root as i2i-yield-watch-sa.json (git-crypt encrypted).
#
# CI: set FIREBASE_SA_JSON to the full JSON contents in
# a GitHub Secret. The workflow writes it to a temp file
# and points FIREBASE_SA_PATH at it.
FIREBASE_SA_PATH=i2i-yield-watch-sa.json
# FIREBASE_SA_JSON={"type":"service_account",...}  # CI only

# --- TELEGRAM NOTIFICATION ---
TELEGRAM_ENABLED=false

# Get from @BotFather on Telegram:
#   1. Open Telegram, search for @BotFather
#   2. Send /newbot and follow the prompts
#   3. Copy the bot token (format: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your Chat ID:
#   1. Start a chat with your bot (send /start)
#   2. Visit in browser:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Look for "chat":{"id": XXXXXXXX}
#   4. Copy that numeric ID
TELEGRAM_CHAT_ID=your_chat_id_here

# --- NTFY.SH NOTIFICATION ---
# Free, open-source HTTP pub-sub service. Subscribe to
# the topic in the ntfy mobile/desktop/web app, then
# this notifier POSTs to <NTFY_BASE_URL>/<NTFY_TOPIC>.
#
# The topic name is the password — pick something
# unguessable. Self-hosting: set NTFY_BASE_URL to your
# server, e.g. https://ntfy.yourdomain.com
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=i2i-yield-watch-your-secret-topic
# Optional: only for access-controlled self-hosted ntfy
# NTFY_USER=your_username
# NTFY_PASSWORD=your_password

# --- DASHBOARD ---
# Your GitHub Pages URL (set after first deployment)
# Format: https://<USERNAME>.github.io/i2i-yield-watch/
DASHBOARD_URL=https://chirag127.github.io/i2i-yield-watch/
